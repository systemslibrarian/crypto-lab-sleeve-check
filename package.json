{
  "name": "crypto-lab-sleeve-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:counts": "node scripts/check-test-counts.mjs",
    "check:ledger": "node scripts/check-ledger.mjs",
    "check:links": "node scripts/check-links.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test --project=a11y",
    "test:claims": "playwright test --project=claims",
    "test:e2e:all": "playwright test",
    "test:flows": "playwright test --project=flows-chromium --project=flows-firefox --project=flows-webkit --project=flows-mobile",
    "test:mutation": "node scripts/mutation.mjs",
    "test:verdicts": "playwright test --project=coverage",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run check:ledger && npm run test:e2e:all && npm run check:counts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
